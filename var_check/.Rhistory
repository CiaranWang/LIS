df1 <- function(input)
{
part1 <- (1 + (C1 / input) ^ B1)^2
part2 <- input ^ (-B1-1)
output <- A1 * B1  * C1^B1 *  part2 / part1
return(output)
}
df2 <- function(input)
{
part1 <- (1 + (C2 / input) ^ B2)^2
part2 <- input ^ (-B2-1)
output <- A2 * B2  * C2^B2 *  part2 / part1
return(output)
}
