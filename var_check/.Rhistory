min  = sapply(summed_meets[, ..vars2], min),
mean = sapply(summed_meets[, ..vars2], mean),
max  = sapply(summed_meets[, ..vars2], max),
var  = sapply(summed_meets[, ..vars2], var)
)
round(tab2,3)
